# Port for the Event-Driven Knowledge Graph HTTP service
PORT=3100

# Path to the LanceDB embedded storage directory
LANCEDB_PATH=./lancedb_data

# Active Vault Path
# If this directory does not exist, the engine automatically bootstraps a clean
# Obsidian/Dataview-ready vault structure (NUCLEO/, OPERACIONES/, VIDA/, Media/) on startup.
VAULT_PATH=./vault

# Comma-separated directories inside the vault to exclude from indexing
IGNORED_VAULT_DIRS=.git,.obsidian,node_modules,BotTrading,Boveda

# Comma-separated project paths or parent directories for Motor 1 (Project Inspector)
PROJECT_SCAN_PATHS=./

# Path to Antigravity conversation transcripts directory for Motor 2 (Chat Crawler)
TRANSCRIPTS_PATH=~/.gemini/antigravity/brain

# Ollama Endpoint for Embeddings (Pure vector algebra ~15ms, zero LLM state hallucinations)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL_EMBED=qwen3-embedding:8b

# Time-Decay & Hybrid Retrieval Weights
DECAY_LAMBDA=0.02
WEIGHT_SIMILARITY=0.55
WEIGHT_TIME=0.30
WEIGHT_IMPORTANCE=0.15
MEDIA_SIMILARITY_THRESHOLD=0.38

# Optional API Key for HTTP endpoint security
API_KEY=your_secure_api_key_here

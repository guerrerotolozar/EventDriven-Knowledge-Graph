# Port for the Event-Driven Knowledge Graph service
PORT=3100

# Path to the LanceDB storage directory
LANCEDB_PATH=./lancedb_data

# Active Vault Path (Use ./vault-template for open-source sandbox or ./Boveda for personal production)
VAULT_PATH=./vault-template

# Ollama Endpoint for Embeddings (Zero LLM thinking for state, pure vector algebra)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL_EMBED=qwen3-embedding:0.6b

# Security API Key for endpoint access
API_KEY=your_secure_api_key_here
